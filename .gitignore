# ==============================================================================
# BillShield AI — .gitignore
# ==============================================================================

# ---------------- Operating System Files ----------------
.DS_Store
Thumbs.db
desktop.ini
ehthumbs.db

# ---------------- Secrets & Environment Variables -------
.env
.env.local
.env.*.local
*.pem
*.key
*.p12
*.pfx

# ---------------- Python --------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
*.pyd
.Python
env/
venv/
.venv/
ENV/
env.bak/
venv.bak/

# Build / distribution
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
pip-wheel-metadata/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Testing & coverage
.pytest_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml
*.cover
.hypothesis/

# Type checkers & linters
.mypy_cache/
.dmypy.json
dmypy.json
.ruff_cache/
.pytype/

# Jupyter / IPython
.ipynb_checkpoints

# PyInstaller
*.manifest
*.spec

# ---------------- Next.js / Node -----------------------
frontend/node_modules/
frontend/.next/
frontend/out/
frontend/build/
frontend/.vercel
*.tsbuildinfo

# Debug logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# ---------------- Database & Uploads -------------------
# Exclude runtime SQLite databases (auto-created on startup)
*.db
*.sqlite
*.sqlite3
# Exclude runtime uploaded/processed documents
/documents/uploads/*
!/documents/uploads/.gitkeep
/documents/processed/
/documents/temp/
storage/

# ---------------- IDE & Editor Files -------------------
.vscode/
.idea/
*.swp
*.swo
*~
*.suo
*.user
.project
.classpath

# ---------------- Docker -------------------------------
# Keep docker-compose.yml and Dockerfiles (source)
# Exclude runtime volumes
data/
pgdata/

# ---------------- Misc ---------------------------------
*.log
*.tmp
*.bak
*.orig
