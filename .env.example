# ==============================================================================
# Hospital Bill Auditor (India) - Environment Configuration
# ==============================================================================

# Application Environment
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO

# Backend API Configuration
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
API_V1_PREFIX=/api/v1
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# ------------------------------------------------------------------------------
# DEMO MODE
# When set to true, the application runs entirely offline using synthetic bills,
# mock OCR extraction, mock LLM explanations, and local rule evaluation.
# No external paid API keys (OpenAI, Gemini, Azure OCR) are needed.
# ------------------------------------------------------------------------------
DEMO_MODE=true

# Database Configuration (PostgreSQL with optional pgvector)
# For quick local testing without PostgreSQL, SQLite can be used:
# DATABASE_URL=sqlite+aiosqlite:///./database/hospital_auditor.db
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/hospital_auditor
ENABLE_PGVECTOR=false

# Document & Object Storage Provider
# Options: "local" (default for demo/dev), "s3"
STORAGE_PROVIDER=local
LOCAL_STORAGE_DIR=./documents/uploads

# OCR Provider Configuration
# Options: "mock" (default for demo), "tesseract", "google_document_ai", "azure_document_intelligence"
OCR_PROVIDER=mock
TESSERACT_CMD=
GOOGLE_APPLICATION_CREDENTIALS=
AZURE_DOCUMENT_INTELLIGENCE_ENDPOINT=
AZURE_DOCUMENT_INTELLIGENCE_KEY=

# AI / LLM Provider Configuration
# Remember: LLM is strictly used for classification and explanation, NEVER for rule evaluation!
# Options: "mock" (default for demo), "gemini", "openai"
LLM_PROVIDER=mock
GEMINI_API_KEY=
OPENAI_API_KEY=
LLM_MODEL=gemini-1.5-flash

# Frontend Configuration
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_DEMO_MODE=true
